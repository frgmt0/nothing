move-parent
move-parent
move-child 1
construct-var letters

# verdict : Str = if all_passed then "everyone passed" else "someone is below 60"
create-definition
rename-def verdict
set-def-ann Str
set-doc the third line of the report
construct-if
construct-var all_passed
move-parent
move-child 1
construct-str "everyone passed"
move-parent
move-child 2
construct-str "someone is below 60"

# main : Cmd ? = print_all (headline :: roll :: verdict :: nil)
create-definition
rename-def main
set-def-ann Cmd ?
set-doc write the three-line report
construct-ap
construct-var print_all
move-parent
move-child 1
construct-cons
construct-var headline
move-parent
move-child 1
construct-cons
construct-var roll
move-parent
move-child 1
construct-cons
construct-var verdict
move-parent
move-child 1
