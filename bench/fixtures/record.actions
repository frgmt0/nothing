# 3. Record construct-and-access (bench/references.md §3), as a document.
#
#   main : Num * Num -> Num = λr:Num * Num. fst r
#   mk   : Num -> Num -> Num * Num = λa:Num. λb:Num. (a, b)
#
# Through Phase 11 the constructor was a `let` wrapped around the accessor,
# because a program was one expression and a `let` was the only way to name
# something. In the document era a top-level name is a definition, which is
# what this program always meant.

# main : Num * Num -> Num = λx0:Num * Num. fst x0
set-def-ann Num * Num -> Num
construct-lam
move-parent
rename x0
set-ann Num * Num
move-child 0
construct-proj l
construct-var x0

# mk : Num -> Num -> Num * Num = λx1:Num. λx2:Num. (x1, x2)
create-definition
rename-def mk
set-def-ann Num -> Num -> Num * Num
construct-lam
move-parent
rename x1
set-ann Num
move-child 0
construct-lam
move-parent
rename x2
set-ann Num
move-child 0
construct-pair
construct-var x1
move-next-sibling
construct-var x2
