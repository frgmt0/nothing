# 1. Factorial (bench/references.md §1), now a real recursive definition.
#
#   main : Num -> Num = λn:Num. if n == 0 then 1 else n * main (n - 1)
#
# Phase B1 gave the document top-level definitions, and a definition is in
# scope in its own body, so the recursive call is an ordinary `construct-var`
# naming `main`. The hole that stood in for it through Phases 1-11 is gone.

# main : Num -> Num
set-def-ann Num -> Num

# λx0:Num. ⦇⦈
construct-lam
move-parent
rename x0
set-ann Num
move-child 0

# if ⦇⦈ == ⦇⦈ then ⦇⦈ else ⦇⦈
construct-if
construct-binop eq
construct-var x0
move-next-sibling
construct-num 0

# then 1
move-parent
move-next-sibling
construct-num 1

# else x0 * main (x0 - 1)
move-next-sibling
construct-var x0
construct-binop mul
construct-ap
construct-var main
move-next-sibling
construct-var x0
construct-binop sub
construct-num 1
